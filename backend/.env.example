PORT=4000
# Comma-separated list
CLIENT_ORIGIN=https://localhost:5173

# Step 14: mediasoup SFU
# The IP the BROWSER must send media to (written into the ICE candidates).
# Dev: your laptop's LAN IP (auto-detected if empty). EC2: the public/Elastic IP.
MEDIASOUP_ANNOUNCED_IP=
# Bind address for the RTC ports (0.0.0.0 = all interfaces)
MEDIASOUP_LISTEN_IP=0.0.0.0
# UDP/TCP port range for media. Open it in the firewall / security group.
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
# Number of mediasoup-worker processes (default: one per CPU core)
MEDIASOUP_WORKERS=
